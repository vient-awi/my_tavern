        "$界面状态": {
          "default": {},
          "type": "object",
          "properties": {
            "视图": {
              "default": "list",
              "type": "string",
              "enum": [
                "list",
                "detail",
                "compose",
                "mail",
                "notice",
                "topic",
                "search",
                "settings",
                "home"
              ]
