              "default": [],
              "type": "array",
              "items": {
                "default": {},
                "type": "object",
                "properties": {
                  "标题": {
                    "default": "",
                    "type": "string"
                  },
                  "内容": {
                    "default": "",
                    "type": "string"
                  },
                  "已读": {
                    "default": false,
                    "type": "boolean"
                  }
                }
              }
