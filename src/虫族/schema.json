            "板块": {
              "default": "热门",
              "type": "string"
            },
            "帖子ID": {
              "default": "",
              "type": "string"
            },
            "公告ID": {
              "default": "",
              "type": "string"
            },
            "话题": {
              "default": "",
              "type": "string"
            },
            "搜索词": {
              "default": "",
              "type": "string"
            },
            "私信对象": {
              "default": "",
              "type": "string"
